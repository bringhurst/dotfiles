#!/usr/bin/env bash

# zshenv for bash
source ~/.bashenv

# This file is only sourced for interactive shells
# Good place for interactive settings, aliases, functions, and prompt customization

# SSH key management with keychain
# Keychain manages SSH keys and their passphrases across login sessions
if command -v keychain >/dev/null 2>&1; then
    # The --noask option makes keychain not prompt for passwords if keys are already loaded
    eval $(keychain --eval --quiet --noask --inherit any ~/.ssh/keys/gh ~/.ssh/keys/li)
else
    echo "keychain not installed. Consider installing it with your package manager."
    # Fall back to basic ssh-agent if keychain isn't available
    if [ -z "$SSH_AUTH_SOCK" ]; then
        eval $(ssh-agent -s)
        ssh-add ~/.ssh/keys/gh ~/.ssh/keys/li 2>/dev/null
    fi
fi

# Initialize atuin for better shell history
# Atuin provides a searchable, synchronized shell history with extra features
eval "$(atuin init bash)"
. "$HOME/.atuin/bin/env"
