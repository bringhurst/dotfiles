#!/usr/bin/env bash

# zshenv for bash
source ~/.bashenv

# This file is only sourced for interactive shells
# Good place for interactive settings, aliases, functions, and prompt customization

# Simple function to manage SSH agent and keys
sagent() {
    # Try to use existing agent socket from environment
    if [ ! -S "$SSH_AUTH_SOCK" ] && [ -f ~/.ssh/ssh-agent.env ]; then
        export SSH_AUTH_SOCK="$(< ~/.ssh/ssh-agent.env)"
    fi

    # If socket doesn't exist or is invalid, start a new agent
    if [ ! -S "$SSH_AUTH_SOCK" ]; then
        # Start new agent
        eval "$(ssh-agent)"

        # Add keys with timeout
        ssh-add -t 2592000 ~/.ssh/keys/gh ~/.ssh/keys/li

        # Cache the socket location for future sessions
        mkdir -p ~/.ssh

        echo "$SSH_AUTH_SOCK" > ~/.ssh/ssh-agent.env
    fi
}

# Run SSH agent management at login
sagent

# Initialize atuin for better shell history
# Atuin provides a searchable, synchronized shell history with extra features
eval "$(atuin init bash)"
. "$HOME/.atuin/bin/env"
