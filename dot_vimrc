" Mouse support
set mouse=a
set ttymouse=sgr
set balloonevalterm

" Styled and colored underline support
let &t_AU = "\e[58:5:%dm"
let &t_8u = "\e[58:2:%lu:%lu:%lum"
let &t_Us = "\e[4:2m"
let &t_Cs = "\e[4:3m"
let &t_ds = "\e[4:4m"
let &t_Ds = "\e[4:5m"
let &t_Ce = "\e[4:0m"

" Strikethrough
let &t_Ts = "\e[9m"
let &t_Te = "\e[29m"

" Truecolor support
let &t_8f = "\e[38:2:%lu:%lu:%lum"
let &t_8b = "\e[48:2:%lu:%lu:%lum"
let &t_RF = "\e]10;?\e\\"
let &t_RB = "\e]11;?\e\\"

" Bracketed paste
let &t_BE = "\e[?2004h"
let &t_BD = "\e[?2004l"
let &t_PS = "\e[200~"
let &t_PE = "\e[201~"

" Cursor control
let &t_RC = "\e[?12$p"
let &t_SH = "\e[%d q"
let &t_RS = "\eP$q q\e\\"
let &t_SI = "\e[5 q"
let &t_SR = "\e[3 q"
let &t_EI = "\e[1 q"
let &t_VS = "\e[?12l"

" Focus tracking
let &t_fe = "\e[?1004h"
let &t_fd = "\e[?1004l"
execute "set <FocusGained>=\<Esc>[I"
execute "set <FocusLost>=\<Esc>[O"

" Window title
let &t_ST = "\e[22;2t"
let &t_RT = "\e[23;2t"

" vim hardcodes background color erase even if the terminfo file does
" not contain bce. This causes incorrect background rendering when
" using a color theme with a background color in terminals such as
" kitty that do not support background color erase.
let &t_ut=''

" Enable filetype detection
if has('autocmd')
  filetype plugin indent on
endif

" Enable highlighting files in color
if has('syntax') && !exists('g:syntax_on')
  syntax enable
endif

" Write to the swap file more often
set updatetime=300

" Always show the sign column
set signcolumn=yes

" Disable compatible mode
set nocompatible

" Copy the indent from the current line when starting a new line.
set autoindent

" Expand indents according to shiftwidth.
set smarttab

" Don't pollute autocomplete with all includes
set complete-=i

" Don't assume numbers are octal
set nrformats-=octal

" Always show the status if more than one window is open.
set laststatus=1

" Set a scroll offset of 1 to leave a one line padding at the top and bottom
" relative to the cursor.
set scrolloff=1

" The number of linkes to keep to the left and right when sidescrolling
" relative to the cursor.
set sidescrolloff=5

" Show as much of the last line as possible
set display+=lastline

" Set a reasonable encoding
if &encoding ==# 'latin1' && has('gui_running')
  set encoding=utf-8
endif

" Automatically reload files that change outside of vim (e.g. IntelliJ)
set autoread

" Make sure viminfo saves uppercase globals
if !empty(&viminfo)
  set viminfo^=!
endif

" Don't save options in sessions (mksession)
set sessionoptions-=options

" Don't save options in views (mkview)
set viewoptions-=options

" Load matchit.vim, but only if the user hasn't installed a newer version.
if !exists('g:loaded_matchit') && findfile('plugin/matchit.vim', &rtp) ==# ''
  runtime! macros/matchit.vim
endif

" Allow backspaces over autoindent, line breaks, and the start of an insert
set backspace=indent,eol,start

" Set the command history size
set history=1000

" Show incomplete commands in the status bar
set showcmd

" Show completion matches in a status line
set wildmenu

" Make ESC work faster
set ttimeout
set ttimeoutlen=100

" Keep buffers loaded even if they're not shown in a window
set hidden

" Set the terminal window title with the name of the file
set icon

set noswapfile

set path=.,**

" Always display the current cursor position
set ruler

" Highlight when searching
set hlsearch

" Update the cursor location as a search is being typed
set incsearch

" Put a column on the 80th and 120th column
let &colorcolumn="80,".join(range(120,999),",")"
highlight ColorColumn ctermbg=235 guibg=#2c2d27

" Hide the netrw banner
let g:netrw_banner = 0

" Use the netrw tree view
let g:netrw_liststyle = 3

" Open new files in a vertical split
let g:netrw_browse_split = 1

" Don't wrap long lines, just scroll them
set nowrap

" Set a reasonable horizontal scroll
set sidescroll=5

" Set special characters to be visible
set listchars=trail:-,extends:>,precedes:<,nbsp:+

" Make sure we have a vim tmp dir
if !isdirectory("/var/tmp/jonb")
    call mkdir("/var/tmp/jonb", "", 0700)
endif
if !isdirectory("/var/tmp/jonb/vim")
    call mkdir("/var/tmp/jonb/vim", "", 0700)
endif

" Setup undo files (files that end with .~un)
if !isdirectory("/var/tmp/jonb/vim/undos")
    call mkdir("/var/tmp/jonb/vim/undos", "", 0700)
endif
set undodir=/var/tmp/jonb/vim/undos
set undofile

" Setup backup files (files that end with .~)
if !isdirectory("/var/tmp/jonb/vim/backups")
    call mkdir("/var/tmp/jonb/vim/backups", "", 0700)
endif
set backupdir=/var/tmp/jonb/vim/backups
set backup
set writebackup

" Setup swap files (files that end with .swp)
if !isdirectory("/var/tmp/jonb/vim/swaps")
    call mkdir("/var/tmp/jonb/vim/swaps", "", 0700)
endif
set directory=/var/tmp/jonb/vim/swaps
set swapfile

" Move the viminfo file to the tmp dir
set viminfofile=/var/tmp/jonb/vim/viminfo

" Set a dir for netrw files (e.g. .netrwhist)
if !isdirectory("/var/tmp/jonb/vim/netrw")
    call mkdir("/var/tmp/jonb/vim/netrw", "", 0700)
endif
let g:netrw_home="/var/tmp/jonb/vim/netrw"

" Increase the default terminal scrollback
set termwinscroll=1000000

" Set the default terminal size to 15 rows and unlimited width
set termwinsize=15x0

" Set the default shift to 4 spaces
set shiftwidth=5

set t_Co=256   " This is may or may not needed.
set background=dark
